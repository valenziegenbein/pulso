// Pulso — esquema de datos (PostgreSQL).
// Multi-tenant lógico: todo cuelga de Organization y se filtra por organizationId.
// Privacidad por diseño: no hay tablas de actividad, mouse, teclado ni capturas
// automáticas. Las capturas (Attachment kind=SCREENSHOT) son siempre manuales.
//
// Nota: los "enums" se guardan como String (validados por las uniones de
// @pulso/shared) y permissions/metadata como JSON en texto. Es a propósito:
// mantiene el dominio agnóstico y la migración desde el prototipo SQLite trivial.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------- Modelos ---------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  planKey   String   @default("FREE")
  seatLimit Int      @default(5)
  createdAt DateTime @default(now())

  teams          Team[]
  roles          Role[]
  memberships    OrgMembership[]
  tasks          Task[]
  blockers       Blocker[]
  decisions      DecisionRequest[]
  agendaEvents   AgendaEvent[]
  worklogEntries WorklogEntry[]
  suggestions    AIWorklogSuggestion[]
  attachments    Attachment[]
  llmConfigs     LLMProviderConfig[]
  auditEvents    AuditEvent[]
  authSessions   AuthSession[]              @relation("ActiveSessionOrganization")
  invites        OrganizationInvite[]
  desktopCodes   DesktopAuthorizationCode[]
  subscription   OrganizationSubscription?
  usageLedger    UsageLedger[]
  aiUsageEvents  AIUsageEvent[]
  billingEvents  BillingWebhookEvent[]
  billingCheckoutAttempts BillingCheckoutAttempt[]
  personalEarlyAccessRequests EarlyAccessRequest[]       @relation("EarlyAccessPersonalOrganization")
  knowledgeSources            KnowledgeSource[]
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  normalizedEmail   String    @unique
  name              String
  passwordHash      String
  avatarUrl         String?
  timezone          String    @default("UTC")
  isSuperAdmin      Boolean   @default(false)
  emailVerifiedAt   DateTime?
  status            String    @default("ACTIVE")
  securityVersion   Int       @default(1)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orgMemberships      OrgMembership[]
  teamMemberships     TeamMembership[]
  assignedTasks       Task[]                     @relation("TaskAssignee")
  createdTasks        Task[]                     @relation("TaskCreatedBy")
  authoredWorklogs    WorklogEntry[]             @relation("WorklogAuthor")
  approvedWorklogs    WorklogEntry[]             @relation("WorklogApprover")
  agendaEvents        AgendaEvent[]
  comments            TaskComment[]
  createdBlockers     Blocker[]
  decisionRequests    DecisionRequest[]
  suggestions         AIWorklogSuggestion[]
  attachments         Attachment[]
  auditEvents         AuditEvent[]
  billingCheckoutAttempts BillingCheckoutAttempt[] @relation("BillingCheckoutCreatedBy")
  authSessions        AuthSession[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  invitesSent         OrganizationInvite[]       @relation("InviteSender")
  invitesAccepted     OrganizationInvite[]       @relation("InviteAcceptor")
  desktopCodes        DesktopAuthorizationCode[]
  earlyAccessRequests     EarlyAccessRequest[]       @relation("EarlyAccessUser")
  earlyAccessDecisions    EarlyAccessRequest[]       @relation("EarlyAccessDecisionBy")
  earlyAccessEvents       EarlyAccessEvent[]         @relation("EarlyAccessEventActor")
  knowledgeSources        KnowledgeSource[]
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  // RoleKey (ver @pulso/shared): SUPER_ADMIN | ORG_ADMIN | TEAM_ADMIN | COORDINATOR | MEMBER | VIEWER
  key            String
  name           String
  // Lista de permisos serializada como JSON (SQLite no soporta String[]).
  permissions    String   @default("[]")
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgMemberships      OrgMembership[]
  teamMemberships     TeamMembership[]
  organizationInvites OrganizationInvite[]

  @@unique([organizationId, key])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model OrgMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         String   @default("ACTIVE")
  isOwner        Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role             @relation(fields: [roleId, organizationId], references: [id, organizationId])
  teamMemberships TeamMembership[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  parentTeamId   String?
  name           String
  description    String?
  focus          String?
  createdAt      DateTime @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent              Team?                @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  children            Team[]               @relation("TeamHierarchy")
  memberships         TeamMembership[]
  tasks               Task[]
  blockers            Blocker[]
  decisions           DecisionRequest[]
  worklogEntries      WorklogEntry[]
  organizationInvites OrganizationInvite[]
  knowledgeSources     KnowledgeSource[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([parentTeamId])
}

model TeamMembership {
  id             String   @id @default(cuid())
  organizationId String
  teamId         String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())

  team          Team          @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId, organizationId], references: [id, organizationId])
  orgMembership OrgMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId, userId])
  @@index([userId])
}

model Task {
  id               String    @id @default(cuid())
  organizationId   String
  teamId           String
  parentTaskId     String?
  title            String
  description      String?
  expectedOutcome  String?
  assigneeId       String?
  createdById      String
  // TaskPriority: LOW | MEDIUM | HIGH | URGENT
  priority         String    @default("MEDIUM")
  // TaskStatus: BACKLOG | TODO | IN_PROGRESS | BLOCKED | IN_REVIEW | DONE | CANCELLED
  status           String    @default("BACKLOG")
  dueDate          DateTime?
  definitionOfDone String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team                  @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  parent         Task?                 @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks       Task[]                @relation("TaskSubtasks")
  assignee       User?                 @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  blockers       Blocker[]
  decisions      DecisionRequest[]
  comments       TaskComment[]
  attachments    Attachment[]
  agendaEvents   AgendaEvent[]
  worklogEntries WorklogEntry[]
  suggestions    AIWorklogSuggestion[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([assigneeId, status])
  @@index([teamId])
  @@index([dueDate])
}

model Blocker {
  id             String    @id @default(cuid())
  organizationId String?
  teamId         String?
  taskId         String?
  title          String    @default("Bloqueo")
  description    String
  status         String    @default("OPEN")
  createdById    String
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy    User          @relation(fields: [createdById], references: [id])

  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([taskId])
}

model DecisionRequest {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String
  taskId         String?
  requestedById  String
  title          String
  context        String
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  requestedBy  User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([taskId])
  @@index([requestedById])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model AgendaEvent {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  // AgendaEventType: MEETING | FOCUS_BLOCK | DEADLINE | MANUAL | TASK_DUE
  type           String
  title          String
  startsAt       DateTime
  endsAt         DateTime?
  taskId         String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([organizationId])
}

model WorklogEntry {
  id             String    @id @default(cuid())
  organizationId String
  authorId       String
  teamId         String?
  taskId         String?
  // WorklogType: PROGRESS | RESEARCH | BLOCKER | DECISION | NOTE | DELIVERY | HELP_REQUEST | RISK | PRIORITY_CHANGE
  type           String
  // WorklogStatus: DRAFT | PUBLISHED | DISCARDED
  status         String    @default("DRAFT")
  // WorklogSource: MANUAL | AI_SUGGESTED
  source         String    @default("MANUAL")
  title          String
  content        String
  approvedById   String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User                 @relation("WorklogAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  approver     User?                @relation("WorklogApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  task         Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  suggestion   AIWorklogSuggestion?
  attachments  Attachment[]

  @@unique([id, organizationId])
  @@index([authorId, status])
  @@index([teamId, createdAt])
  @@index([organizationId, status])
}

model AIWorklogSuggestion {
  id               String   @id @default(cuid())
  organizationId   String
  requestedById    String
  taskId           String?
  inputNote        String
  suggestedType    String
  suggestedTitle   String
  suggestedContent String
  providerType     String
  model            String
  worklogEntryId   String?  @unique
  createdAt        DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  worklogEntry WorklogEntry? @relation(fields: [worklogEntryId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  // AttachmentKind: LINK | FILE | SCREENSHOT
  kind           String
  url            String
  note           String?
  // Las capturas (SCREENSHOT) son SIEMPRE manuales y voluntarias.
  isManual       Boolean  @default(true)
  uploadedById   String
  taskId         String?
  worklogEntryId String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  task         Task?         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  worklogEntry WorklogEntry? @relation(fields: [worklogEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([taskId])
  @@index([worklogEntryId])
}

model KnowledgeSource {
  id                String    @id @default(cuid())
  organizationId    String
  ownerId           String
  teamId            String?
  scope             String
  clientProjectId   String?
  clientSourceId    String
  name              String
  consentAt         DateTime
  lastSyncId        String?
  lastSyncedAt      DateTime?
  fileCount         Int       @default(0)
  chunkCount        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team         Team?           @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@unique([organizationId, ownerId, clientSourceId])
  @@unique([id, organizationId])
  @@index([organizationId, scope, clientProjectId])
  @@index([teamId])
  @@index([ownerId])
}

model KnowledgeChunk {
  id               String   @id @default(cuid())
  organizationId   String
  sourceId         String
  relativePath     String
  ordinal          Int
  heading          String
  contentEncrypted String
  contentHash      String
  embeddingModel   String
  embeddingJson    String
  syncId           String
  updatedAt        DateTime @updatedAt

  source KnowledgeSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([sourceId, relativePath, ordinal])
  @@index([organizationId, sourceId])
  @@index([sourceId, syncId])
}

model LLMProviderConfig {
  id              String   @id @default(cuid())
  organizationId  String
  // LLMProviderType: OPENAI_COMPATIBLE | ANTHROPIC | MOCK
  providerType    String
  baseUrl         String?
  model           String
  // API key cifrada (AES-256-GCM). NUNCA se expone al frontend.
  apiKeyEncrypted String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String
  // AuditAction (ver @pulso/domain/casos de uso): TASK_CREATED, TASK_ASSIGNED, ...
  action         String
  entityType     String
  entityId       String
  // Metadata serializada como JSON (SQLite no tiene tipo Json garantizado).
  metadata       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
}

model AuthSession {
  id                   String    @id @default(cuid())
  tokenHash            String    @unique
  userId               String
  activeOrganizationId String?
  securityVersion      Int
  deviceName           String?
  userAgentHash        String?
  createdAt            DateTime  @default(now())
  lastSeenAt           DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation("ActiveSessionOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([activeOrganizationId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OrganizationInvite {
  id              String    @id @default(cuid())
  organizationId  String
  normalizedEmail String
  roleId          String
  teamId          String?
  tokenHash       String    @unique
  pendingKey      String?   @unique
  status          String    @default("PENDING")
  invitedById     String
  acceptedById    String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId])
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy    User         @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, normalizedEmail, status])
  @@index([teamId])
  @@index([expiresAt])
}

model DesktopAuthorizationCode {
  id                   String    @id @default(cuid())
  codeHash             String    @unique
  userId               String
  activeOrganizationId String?
  codeChallenge        String
  redirectUri          String
  createdAt            DateTime  @default(now())
  expiresAt            DateTime
  consumedAt           DateTime?

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
}

model AuthRateLimitBucket {
  id              String    @id @default(cuid())
  action          String
  keyHash         String
  windowStartedAt DateTime
  attemptCount    Int       @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([action, keyHash])
  @@index([blockedUntil])
}

model PlanDefinition {
  key                    String   @id
  name                   String
  defaultSeatLimit       Int
  managedAiIncludedUnits Int      @default(0)
  allowByok              Boolean  @default(true)
  allowLocalAi           Boolean  @default(true)
  customizableSeats      Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  subscriptions OrganizationSubscription[]
}

model OrganizationSubscription {
  id             String   @id @default(cuid())
  organizationId String   @unique
  planKey        String
  status         String   @default("ACTIVE")
  provider       String   @default("MOCK")
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  trialEndsAt            DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         PlanDefinition @relation(fields: [planKey], references: [key])

  @@index([planKey, status])
  @@index([provider, providerCustomerId])
  @@unique([provider, providerSubscriptionId])
}

model BillingCheckoutAttempt {
  id                     String   @id @default(cuid())
  organizationId         String
  createdById            String
  provider               String
  offerId                 String
  priceVersionId          String
  planKey                 String
  seats                   Int
  currency                String
  listAmountCentavos      Int
  chargedAmountCentavos   Int
  discountBps             Int
  discountMonths          Int
  status                   String   @default("CREATED")
  providerCheckoutId       String?
  providerSubscriptionId   String?
  expiresAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("BillingCheckoutCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerSubscriptionId])
  @@index([organizationId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([expiresAt])
}

model BillingWebhookEvent {
  id              String    @id @default(cuid())
  organizationId  String
  provider        String
  externalEventId String
  type            String
  status          String    @default("RECEIVED")
  payloadHash     String
  attempts        Int       @default(0)
  processedAt     DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model EmailOutbox {
  id                String    @id @default(cuid())
  idempotencyKey    String    @unique
  recipient         String
  template          String
  payloadEncrypted  String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
  @@index([recipient, createdAt])
}

model EarlyAccessRequest {
  id                     String    @id @default(cuid())
  normalizedEmail        String
  name                   String
  product                String
  status                 String    @default("PENDING")
  source                 String    @default("MARKETING_CONTACT")
  message                String
  consentAt              DateTime
  requestCount           Int       @default(1)
  lastRequestedAt        DateTime  @default(now())
  decisionAt             DateTime?
  decisionNote           String?
  decisionById           String?
  userId                 String?
  personalOrganizationId String?
  claimTokenHash         String?   @unique
  claimExpiresAt         DateTime?
  claimedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  decisionBy           User?              @relation("EarlyAccessDecisionBy", fields: [decisionById], references: [id], onDelete: SetNull)
  user                 User?              @relation("EarlyAccessUser", fields: [userId], references: [id], onDelete: SetNull)
  personalOrganization Organization?      @relation("EarlyAccessPersonalOrganization", fields: [personalOrganizationId], references: [id], onDelete: SetNull)
  events               EarlyAccessEvent[]

  @@unique([normalizedEmail, product])
  @@index([status, lastRequestedAt])
  @@index([userId])
  @@index([personalOrganizationId])
}

model EarlyAccessEvent {
  id        String   @id @default(cuid())
  requestId String
  actorId   String?
  type      String
  metadata  String?
  createdAt DateTime @default(now())

  request EarlyAccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?              @relation("EarlyAccessEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}

model UsageLedger {
  id             String   @id @default(cuid())
  organizationId String
  kind           String
  units          Int
  idempotencyKey String   @unique
  periodStart    DateTime
  metadata       String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiUsageEvent AIUsageEvent?

  @@index([organizationId, kind, periodStart])
}

model AIUsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  providerType   String
  model          String
  operation      String
  inputTokens    Int
  outputTokens   Int
  managed        Boolean  @default(false)
  idempotencyKey String   @unique
  ledgerEntryId  String?  @unique
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntry  UsageLedger? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
