# Copiá este archivo a `.env` (junto a docker-compose.yml) y completá los valores.
# NO lo commitees. Generá los secretos con:  openssl rand -hex 32

# Contraseña de Postgres (elegí una fuerte)
POSTGRES_PASSWORD=cambiame-por-algo-fuerte

# Secretos de la app — 32 bytes en hex (64 caracteres). Uno por línea, distintos.
AUTH_SECRET=
WORKLOG_ENCRYPTION_KEY=

# Puerto público del host (lo que exponés; detrás poné tu reverse proxy + TLS)
APP_PORT=3000

# --- IA (opcional) ---
# Sin esto el "pulso" usa un resumen heurístico y las sugerencias el mock.
# Para IA real apuntá a un endpoint OpenAI-compatible o Anthropic:
#   LLM_PROVIDER=OPENAI_COMPATIBLE   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini   LLM_API_KEY=sk-...
#   LLM_PROVIDER=ANTHROPIC           LLM_MODEL=claude-haiku-4-5-20251001       LLM_API_KEY=sk-ant-...
LLM_PROVIDER=MOCK
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
