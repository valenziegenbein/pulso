# Copia este archivo a `.env` junto a docker-compose.yml y completa valores.
# NO lo commitees. Genera secretos con: openssl rand -hex 32

# Password de Postgres.
POSTGRES_PASSWORD=cambiame-por-algo-fuerte

# Secretos de la app: 32 bytes en hex (64 caracteres), uno por linea, distintos.
AUTH_SECRET=
WORKLOG_ENCRYPTION_KEY=

# Puerto publico del host. Pone tu reverse proxy + TLS delante de este puerto.
APP_PORT=3000

# IA Teams:
# Se configura por organizacion desde Pulso Admin -> IA de la organizacion.
# Sin config activa, el pulso usa resumen heuristico y las sugerencias usan mock.
# Para LM Studio desde Docker, el Base URL debe ser alcanzable desde el contenedor,
# por ejemplo: http://host.docker.internal:1234/v1
