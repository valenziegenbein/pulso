# Pulso — reverse proxy con HTTPS automático.
# {$DOMAIN} se toma del entorno (ver .env / docker-compose). Caddy obtiene y
# renueva el certificado de Let's Encrypt solo, siempre que el dominio resuelva
# a este servidor y los puertos 80/443 estén abiertos.
{$DOMAIN} {
	encode zstd gzip

	# Defensa adicional: el servidor también falla cerrado mediante feature flags.
	@blocked_register path /register /register/*
	respond @blocked_register 404

	@blocked_personal_api path /api/personal /api/personal/*
	respond @blocked_personal_api 404

	reverse_proxy app:3000
}
