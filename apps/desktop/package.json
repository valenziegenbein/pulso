{
  "name": "@pulso/desktop",
  "version": "0.1.27",
  "private": true,
  "description": "Shell de escritorio de Pulso (Electron): panel principal + widget flotante always-on-top. Empaqueta el server Next standalone.",
  "author": "Pulso",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "security:check": "node --check main.js && node --check preload.js && node --check preload-teams.js && node security-check.cjs",
    "prepare:standalone": "node prepare-standalone.cjs",
    "dist:dir": "node prepare-standalone.cjs && electron-builder --dir",
    "dist": "node prepare-standalone.cjs && electron-builder --win nsis",
    "release": "node prepare-standalone.cjs && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.pulso.desktop",
    "productName": "Pulso",
    "electronVersion": "33.4.11",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "preload-teams.js", "markdown.js", "notes-index.js", "embeddings-index.js", "package.json", "pulso.defaults.json", "build/icon.png"],
    "extraResources": [
      { "from": "../../apps/web/.next/standalone", "to": "server" },
      { "from": "db-template", "to": "db-template" }
    ],
    "publish": [
      { "provider": "github", "owner": "valenziegenbein", "repo": "pulso", "releaseType": "release" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Pulso"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
