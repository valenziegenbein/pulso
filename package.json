{
  "name": "pulso",
  "version": "0.0.0",
  "private": true,
  "description": "Pulso — organizador interno de equipos, tareas, agenda y bitácora asistida por IA. Hace visible el trabajo invisible sin vigilar al trabajador.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:db": "node scripts/run-postgres-integration.mjs",
    "email:worker:once": "pnpm --filter @pulso/database exec tsx ../../scripts/process-email-outbox.ts",
    "email:oauth:configure": "pnpm --filter @pulso/database exec tsx ../../scripts/configure-gmail-oauth.ts",
    "test:watch": "vitest",
    "check:production-safety": "node scripts/check-production-safety.mjs",
    "green": "pnpm typecheck && pnpm test && pnpm test:db && pnpm lint && pnpm build && pnpm --filter @pulso/desktop security:check && pnpm check:production-safety && git diff --check",
    "db:generate": "pnpm --filter @pulso/database generate",
    "db:migrate": "pnpm --filter @pulso/database migrate",
    "db:seed": "pnpm --filter @pulso/database seed",
    "db:studio": "pnpm --filter @pulso/database studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
